{
  "schema_version": 1,
  "board": "raspberry-pi-5",
  "os": "Raspberry Pi OS / Debian arm64 with RP1 on gpiochip0",
  "architecture": "aarch64",
  "abi": "gnu",
  "libc": "glibc",
  "identity": {"architecture": "aarch64", "model_prefix": "Raspberry Pi 5"},
  "toolchain": {"cc": "aarch64-linux-gnu-gcc", "cxx": "aarch64-linux-gnu-g++"},
  "runtimes": {"python": "/usr/bin/python3"},
  "startup": {
    "init": "systemd",
    "manager": "gar-target",
    "application_root": "/opt/gar/apps",
    "service_template": "gar-app@.service",
    "after": "network-online.target",
    "device_wait_seconds": 20
  },
  "gpio": [{
    "device": "/dev/gpiochip0",
    "label": "pinctrl-rp1",
    "line_count": 54,
    "lines": [17, 18, 22, 23, 24, 27],
    "line_pins": {"17": 11, "18": 12, "22": 15, "23": 16, "24": 18, "27": 13},
    "voltage_v": 3.3
  }],
  "spi": [{
    "device": "/dev/spidev0.0", "bus": 0, "chip_select": 0,
    "modes": [0, 1, 2, 3], "max_speed_hz": 50000000,
    "pins": {"mosi": 19, "miso": 21, "sclk": 23, "cs": 24},
    "routing": {"mosi": 10, "miso": 9, "sclk": 11, "cs": 8}
  }],
  "i2c": [{"device": "/dev/i2c-1", "bus": 1, "pins": {"sda": 3, "scl": 5}}],
  "preparation": {"kind": "raspberry-pi-config", "spi_enable": ["raspi-config", "nonint", "do_spi", "0"]},
  "verification": {
    "date": "2026-11-01",
    "scope": "Documented subset used by existing Products; no fresh physical-board test. gpiochip0 must identify pinctrl-rp1. The 50 MHz SPI profile ceiling preserves the existing GAR contract and is not a guarantee for every peripheral or cable.",
    "sources": [
      "https://www.raspberrypi.com/documentation/computers/raspberry-pi.html",
      "https://pip-assets.raspberrypi.com/categories/685-app-notes-guides-whitepapers/documents/RP-006553-WP/A-history-of-GPIO-usage-on-Raspberry-Pi-devices-and-current-best-practices"
    ]
  }
}
